# Copy this file to keystore.properties (same folder, already git-ignored)
# and fill in your real values to build a signed release locally, e.g. from
# Android Studio's Build > Generate Signed App Bundle.
#
# Never commit the real keystore.properties file or your .jks/.keystore file
# to git - keep them somewhere safe outside the repo (a password manager or
# an encrypted backup). If you lose this keystore, you can no longer publish
# updates to the same Play Store listing.
storeFile=../matra-mitra-release.jks
storePassword=CHANGE_ME
keyAlias=matra-mitra
keyPassword=CHANGE_ME
